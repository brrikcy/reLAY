# Relay binds to localhost by default. No API key is needed for demo mode.
PORT=8787
HOST=127.0.0.1

# Optional: use a different SQLite file inside the project.
# RELAY_DATA_FILE=./data/relay.db

# Only enable this for trusted local APIs. It disables private-network SSRF blocking.
# RELAY_ALLOW_PRIVATE_NETWORK=true
